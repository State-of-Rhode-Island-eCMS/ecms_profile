{
  "env": {
    "browser": true,
    "es6": true,
    "node": true
  },
  "globals": {
    "Drupal": "readonly",
    "drupalSettings": "readonly",
    "once": "readonly",
    "a11yClick": "readonly",
    "allMenuCloser": "readonly",
    "addPageOverlay": "readonly",
    "activatePageOverlay": "readonly",
    "deactivatePageOverlay": "readonly",
    "getCookie": "readonly",
    "_forEach": "readonly"
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2018,
    "sourceType": "module"
  },
  "rules": {
    "indent": [
      "error",
      2
    ],
    "linebreak-style": [
      "error",
      "unix"
    ],
    "quotes": [
      "error",
      "single"
    ],
    "semi": [
      "error",
      "always"
    ],
    "no-unused-vars": "off"
  }
}
